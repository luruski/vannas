<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-8">
      <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><%= link_to "Home", root_path %></li>
          <li class="breadcrumb-item">
            <%= link_to @product.category.name, root_path(category_id: @product.category.id) %>
          </li>
          <li class="breadcrumb-item active"><%= @product.name %></li>
        </ol>
      </nav>

      <div class="card shadow-sm">
        <% if @product.image.attached? %>
          <%= image_tag @product.image.variant(:medium), class: "card-img-top", alt: @product.name %>
        <% end %>
        <div class="card-body p-5">
          <span class="badge bg-primary mb-3"><%= @product.category.name %></span>
          <% if @product.on_sale %>
            <span class="badge bg-danger mb-3">On Sale</span>
          <% end %>
          <h1 class="card-title mb-3"><%= @product.name %></h1>
          <p class="card-text text-muted fs-5 mb-4"><%= @product.description %></p>
          <div class="d-flex justify-content-between align-items-center">
            <% if @product.on_sale && @product.sale_price %>
              <span>
                <span class="text-decoration-line-through text-muted fs-5"><%= number_to_currency(@product.price) %></span>
                <span class="fw-bold fs-3 text-danger"><%= number_to_currency(@product.sale_price) %></span>
              </span>
            <% else %>
              <span class="fw-bold fs-3"><%= number_to_currency(@product.price) %></span>
            <% end %>
            <% if @product.available %>
              <span class="badge bg-success fs-6">Available</span>
            <% else %>
              <span class="badge bg-secondary fs-6">Unavailable</span>
            <% end %>
          </div>
          <hr>
          <%= button_to "Add to Cart", add_to_cart_path(@product.id),
              method: :post,
              class: "btn btn-primary mt-3" %>
          <%= link_to "Back to All Products", root_path, class: "btn btn-outline-secondary mt-3" %>
        </div>
      </div>
    </div>
  </div>
</div>