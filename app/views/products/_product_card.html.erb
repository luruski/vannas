<div class="col">
  <div class="card h-100 shadow-sm">
    <% if product.image.attached? %>
      <%= image_tag product.image.variant(:thumb), class: "card-img-top", alt: product.name %>
    <% end %>
    <div class="card-body">
      <span class="badge bg-primary mb-2"><%= product.category.name %></span>
      <% if product.on_sale %>
        <span class="badge bg-danger mb-2">On Sale</span>
      <% end %>
      <h5 class="card-title"><%= product.name %></h5>
      <p class="card-text text-muted"><%= truncate(product.description, length: 100) %></p>
    </div>
    <div class="card-footer">
      <div class="d-flex justify-content-between align-items-center mb-2">
        <% if product.on_sale && product.sale_price %>
          <span>
            <span class="text-decoration-line-through text-muted"><%= number_to_currency(product.price) %></span>
            <span class="fw-bold fs-5 text-danger"><%= number_to_currency(product.sale_price) %></span>
          </span>
        <% else %>
          <span class="fw-bold fs-5"><%= number_to_currency(product.price) %></span>
        <% end %>
        <%= link_to "View Details", product_path(product), class: "btn btn-outline-primary btn-sm" %>
      </div>
      <%= button_to "Add to Cart", add_to_cart_path(product.id),
          method: :post,
          class: "btn btn-primary w-100 btn-sm" %>
    </div>
  </div>
</div>