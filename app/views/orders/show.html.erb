<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-8">
      <div class="text-center mb-5">
        <h1 class="text-success">Order Confirmed!</h1>
        <p class="lead">Thank you for your order. Vanna's Bakery will be in touch soon!</p>
      </div>

      <div class="card shadow-sm mb-4">
        <div class="card-header bg-dark text-white">
          <h5 class="mb-0">Order #<%= @order.id %></h5>
        </div>
        <div class="card-body">
          <p>
            <strong>Status:</strong>
            <% if @order.status == "pending" %>
              <span class="badge bg-warning">Pending</span>
            <% elsif @order.status == "paid" %>
              <span class="badge bg-success">Paid</span>
            <% elsif @order.status == "shipped" %>
              <span class="badge bg-primary">Shipped</span>
            <% end %>
          </p>
          <% if @order.pickup_date %>
            <p><strong>Pickup Date:</strong> <%= @order.pickup_date.strftime("%B %d, %Y") %></p>
          <% end %>
          <% if @order.notes.present? %>
            <p><strong>Special Instructions:</strong> <%= @order.notes %></p>
          <% end %>
        </div>
      </div>

      <div class="card shadow-sm mb-4">
        <div class="card-header bg-dark text-white">
          <h5 class="mb-0">Items Ordered</h5>
        </div>
        <div class="table-responsive">
          <table class="table mb-0">
            <thead class="table-light">
              <tr>
                <th>Product</th>
                <th>Price at Purchase</th>
                <th>Quantity</th>
                <th>Subtotal</th>
              </tr>
            </thead>
            <tbody>
              <% @order.order_items.each do |item| %>
                <tr>
                  <td><%= item.product.name %></td>
                  <td><%= number_to_currency(item.price_at_purchase) %></td>
                  <td><%= item.quantity %></td>
                  <td><%= number_to_currency(item.price_at_purchase * item.quantity) %></td>
                </tr>
              <% end %>
            </tbody>
            <tfoot class="table-light">
              <tr>
                <td colspan="3" class="text-end">Subtotal:</td>
                <td><%= number_to_currency(@order.total) %></td>
              </tr>
              <% if @order.gst_amount > 0 %>
                <tr>
                  <td colspan="3" class="text-end">GST:</td>
                  <td><%= number_to_currency(@order.gst_amount) %></td>
                </tr>
              <% end %>
              <% if @order.pst_amount > 0 %>
                <tr>
                  <td colspan="3" class="text-end">PST:</td>
                  <td><%= number_to_currency(@order.pst_amount) %></td>
                </tr>
              <% end %>
              <% if @order.hst_amount > 0 %>
                <tr>
                  <td colspan="3" class="text-end">HST:</td>
                  <td><%= number_to_currency(@order.hst_amount) %></td>
                </tr>
              <% end %>
              <tr class="fw-bold">
                <td colspan="3" class="text-end fs-5">Grand Total:</td>
                <td class="fs-5"><%= number_to_currency(@order.grand_total) %></td>
              </tr>
            </tfoot>
          </table>
        </div>
      </div>

      <div class="d-flex justify-content-between">
        <%= link_to "Continue Shopping", root_path, class: "btn btn-outline-secondary" %>
        <%= link_to "View All Orders", orders_path, class: "btn btn-primary" %>
      </div>
    </div>
  </div>
</div>