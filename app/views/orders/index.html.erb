<div class="container py-5">
  <h1 class="mb-4">Your Orders</h1>

  <% if @orders.empty? %>
    <div class="text-center py-5">
      <h4 class="text-muted">You have no orders yet.</h4>
      <%= link_to "Start Shopping", root_path, class: "btn btn-primary mt-3" %>
    </div>
  <% else %>
    <% @orders.each do |order| %>
      <div class="card shadow-sm mb-3">
        <div class="card-body d-flex justify-content-between align-items-center">
          <div>
            <h5 class="mb-1">Order #<%= order.id %></h5>
            <p class="text-muted mb-0"><%= order.created_at.strftime("%B %d, %Y") %></p>
            <% if order.status == "pending" %>
              <span class="badge bg-warning">Pending</span>
            <% elsif order.status == "paid" %>
              <span class="badge bg-success">Paid</span>
            <% elsif order.status == "shipped" %>
              <span class="badge bg-primary">Shipped</span>
            <% end %>
          </div>
          <div class="text-end">
            <p class="fw-bold fs-5 mb-1"><%= number_to_currency(order.grand_total) %></p>
            <%= link_to "View Details", order_path(order), class: "btn btn-outline-primary btn-sm" %>
          </div>
        </div>
      </div>
    <% end %>
  <% end %>
</div>